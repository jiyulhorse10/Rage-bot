RunService.RenderStepped:Connect(function()
    Label.Text = "Rage Bot: " .. (IsActive and "ON" or "OFF")
    Label.TextColor3 = IsActive and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end)

print("God Mode Rage Bot Loaded! Press Q to Toggle.")
